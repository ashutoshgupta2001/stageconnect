NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://stageconnect:stageconnect_dev@127.0.0.1:5433/stageconnect
TEST_DATABASE_URL=postgres://stageconnect:stageconnect_dev@127.0.0.1:5433/stageconnect_test
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_ISSUER=stageconnect
JWT_AUDIENCE=stageconnect-api
JWT_TTL_SECONDS=900
BCRYPT_ROUNDS=12
TRUST_PROXY_HOPS=0
CORS_ORIGINS=http://localhost:3001
LOG_LEVEL=info
# Required only for the development seed command. Never used in production.
SEED_PASSWORD=
