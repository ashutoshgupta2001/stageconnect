{
  "openapi": "3.1.0",
  "info": {
    "title": "StageConnect API",
    "version": "1.0.0",
    "description": "Express + Sequelize + PostgreSQL artist booking API. All JSON responses use {success,data,error}. Artist profiles are stored relationally with JSONB metadata. Login is public; business endpoints use bearer JWTs. Business endpoints are versioned under /api/v1. The /health readiness probe is unversioned. Unsupported API versions and unversioned business paths return 404 for otherwise well-formed requests."
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Configured VS Code project on this computer"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local development"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Authentication"
    },
    {
      "name": "Bookings"
    },
    {
      "name": "Reviews"
    },
    {
      "name": "Operations"
    }
  ],
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "operationId": "login",
        "security": [],
        "summary": "Authenticate and issue an access token",
        "description": "Email is case-insensitive. Passwords are compared with bcrypt without trimming; maximum 72 UTF-8 bytes. Unknown accounts, wrong passwords and disabled accounts return identical 401 responses. JWT claims include sub, role, iat, exp, iss and aud.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "413": {
            "$ref": "#/components/responses/Error413"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        }
      }
    },
    "/api/v1/bookings": {
      "post": {
        "tags": [
          "Bookings"
        ],
        "operationId": "createBooking",
        "summary": "Create a pending booking request",
        "description": "Clients only. Server derives client identity. Timezone is required; timestamps have at most millisecond precision. Start must not be in the past and end must follow start. Half-open intervals allow adjacent bookings. Pending requests may overlap; confirmed, in_progress and completed intervals reserve the artist's time. No idempotency-key support is provided.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookingRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pending booking created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "413": {
            "$ref": "#/components/responses/Error413"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        }
      }
    },
    "/api/v1/bookings/{id}/status": {
      "patch": {
        "tags": [
          "Bookings"
        ],
        "operationId": "updateBookingStatus",
        "summary": "Apply one legal booking transition",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "description": "Assigned artist: pending\u2192confirmed, confirmed\u2192in_progress (start has arrived), in_progress\u2192completed (end has arrived). Either participant: pending\u2192cancelled or confirmed\u2192cancelled. Every other transition, including self-transitions and unknown statuses, returns 422. Object ownership is checked first (404); then transition legality (422); then actor permission (403). Confirmation rechecks availability inside a transaction. Changes and history are atomic.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Booking updated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "413": {
            "$ref": "#/components/responses/Error413"
          },
          "415": {
            "$ref": "#/components/responses/Error415"
          },
          "422": {
            "$ref": "#/components/responses/Error422"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        }
      }
    },
    "/api/v1/artists/{id}/reviews": {
      "get": {
        "tags": [
          "Reviews"
        ],
        "operationId": "listArtistReviews",
        "summary": "List completed-booking reviews and a global summary",
        "description": "Either authenticated role may read reviews. Filtering to completed bookings occurs before pagination. Sort is created_at DESC, id DESC. Summary covers all eligible reviews in the same snapshot. Empty and out-of-range pages return 200. Repeated, empty, fractional, unknown and overflowing query parameters are rejected.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page and global summary.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewsResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Operations"
        ],
        "operationId": "health",
        "security": [],
        "summary": "Database readiness probe",
        "responses": {
          "200": {
            "description": "Ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "Error400": {
        "description": "Malformed request or invalid input type.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Error401": {
        "description": "Invalid credentials or missing/invalid/expired bearer token.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Error403": {
        "description": "The caller cannot perform this operation.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Error404": {
        "description": "Resource missing or not visible to this caller.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Error405": {
        "description": "Method not allowed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Error409": {
        "description": "The artist has an overlapping reservation.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Error413": {
        "description": "JSON body exceeds 32 KB.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Error415": {
        "description": "Content-Type must be application/json.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Error422": {
        "description": "Invalid state transition, time guard, or booking time window.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Error429": {
        "description": "Rate limit exceeded.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Error500": {
        "description": "Unexpected internal failure.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Error503": {
        "description": "Service temporarily unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {},
            "required": []
          },
          "error": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "success",
          "data",
          "error"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "writeOnly": true,
            "description": "Unmodified password; no NUL; maximum 72 UTF-8 bytes."
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "access_token": {
                "type": "string"
              },
              "token_type": {
                "type": "string",
                "const": "Bearer"
              },
              "expires_in": {
                "type": "integer",
                "minimum": 60,
                "maximum": 3600
              },
              "user": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "artist",
                      "client"
                    ]
                  }
                },
                "required": [
                  "id",
                  "role"
                ]
              }
            },
            "required": [
              "access_token",
              "token_type",
              "expires_in",
              "user"
            ]
          },
          "error": {
            "type": "string",
            "const": ""
          }
        },
        "required": [
          "success",
          "data",
          "error"
        ]
      },
      "CreateBookingRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artist_id": {
            "type": "string",
            "format": "uuid"
          },
          "event_start": {
            "type": "string",
            "format": "date-time"
          },
          "event_end": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000,
            "description": "Nonblank after trimming. NUL is forbidden."
          }
        },
        "required": [
          "artist_id",
          "event_start",
          "event_end",
          "notes"
        ]
      },
      "StatusRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "confirmed",
              "in_progress",
              "completed",
              "cancelled"
            ],
            "description": "Unknown status strings return 422; missing/non-string status returns 400."
          }
        },
        "required": [
          "status"
        ]
      },
      "Booking": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "artist_id": {
            "type": "string",
            "format": "uuid"
          },
          "client_id": {
            "type": "string",
            "format": "uuid"
          },
          "event_start": {
            "type": "string",
            "format": "date-time"
          },
          "event_end": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "confirmed",
              "in_progress",
              "completed",
              "cancelled"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "artist_id",
          "client_id",
          "event_start",
          "event_end",
          "notes",
          "status",
          "created_at",
          "updated_at"
        ]
      },
      "BookingResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "booking": {
                "$ref": "#/components/schemas/Booking"
              }
            },
            "required": [
              "booking"
            ]
          },
          "error": {
            "type": "string",
            "const": ""
          }
        },
        "required": [
          "success",
          "data",
          "error"
        ]
      },
      "Review": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "comment": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "score",
          "comment",
          "created_at"
        ]
      },
      "ReviewSummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "average_score": {
            "type": "string",
            "pattern": "^[0-5]\\.\\d{2}$",
            "examples": [
              "4.50",
              "0.00"
            ],
            "description": "Exactly two decimal places. Use total_count=0 to display no reviews."
          },
          "total_count": {
            "type": "integer",
            "minimum": 0
          },
          "score_distribution": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "1": {
                "type": "integer",
                "minimum": 0
              },
              "2": {
                "type": "integer",
                "minimum": 0
              },
              "3": {
                "type": "integer",
                "minimum": 0
              },
              "4": {
                "type": "integer",
                "minimum": 0
              },
              "5": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "1",
              "2",
              "3",
              "4",
              "5"
            ]
          }
        },
        "required": [
          "average_score",
          "total_count",
          "score_distribution"
        ]
      },
      "Pagination": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total_pages": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "page",
          "limit",
          "total_pages"
        ]
      },
      "ReviewsResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "artist_id": {
                "type": "string",
                "format": "uuid"
              },
              "reviews": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Review"
                }
              },
              "summary": {
                "$ref": "#/components/schemas/ReviewSummary"
              },
              "pagination": {
                "$ref": "#/components/schemas/Pagination"
              }
            },
            "required": [
              "artist_id",
              "reviews",
              "summary",
              "pagination"
            ]
          },
          "error": {
            "type": "string",
            "const": ""
          }
        },
        "required": [
          "success",
          "data",
          "error"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "type": "string",
                "const": "ok"
              }
            },
            "required": [
              "status"
            ]
          },
          "error": {
            "type": "string",
            "const": ""
          }
        },
        "required": [
          "success",
          "data",
          "error"
        ]
      }
    }
  }
}
